<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style project so plain `dotnet build` works without Visual Studio or an
       installed .NET Framework targeting pack (Microsoft.NETFramework.ReferenceAssemblies
       is pulled in automatically for .NET Framework targets). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ShowDesktopOneMonitor</RootNamespace>
    <AssemblyName>ShowDesktopOneMonitor</AssemblyName>
    <ProjectGuid>{66306A9A-9CB5-41AF-88CE-4F997C75D8B6}</ProjectGuid>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>sde.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <!-- The legacy packages.config next to this project is unused; make sure NuGet
         restores this project as PackageReference (the .NET Framework reference
         assemblies arrive that way). -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Windows.Forms and System.Configuration are not part of the implicit
         .NET Framework reference set; System.Configuration carries ApplicationSettingsBase. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon is read from the executable itself (ApplicationIcon), so the
         legacy binary-serialized Resources.resx is no longer used: the SDK resource
         task cannot process non-string resources without a VS task host. -->
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <Compile Remove="Properties\Resources.Designer.cs" />
  </ItemGroup>

</Project>
